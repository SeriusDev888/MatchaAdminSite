STUDIO_DATABASE=supabase
SUPABASE_URL=https://MATCHA_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=REPLACE_WITH_MATCHA_SERVER_SECRET
SUPABASE_STORAGE_BUCKET=studio-media
SITE_ORIGIN=https://YOUR_MATCHA_SITE.vercel.app
LOCAL_AUTH_SETUP=false
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://YOUR_MATCHA_ADMIN.vercel.app/api/auth/google/callback
# Only for a database that does not already have a superadmin:
# ADMIN_SETUP_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
