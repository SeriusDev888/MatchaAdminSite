# Copy to .env after running supabase/schema.sql in the Matcha Supabase project.
STUDIO_DATABASE=supabase
SUPABASE_URL=https://MATCHA_PROJECT_REF.supabase.co
# Server-only secret key (sb_secret_...) or legacy service_role JWT.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=studio-media
SITE_ORIGIN=http://127.0.0.1:3000
PORT=4321
LOCAL_AUTH_SETUP=true
# Required for first superadmin setup on HTTPS hosting; set as a runtime secret.
ADMIN_SETUP_TOKEN=

# Google OAuth Web application (optional). Keep the secret on the server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4321/api/auth/google/callback
